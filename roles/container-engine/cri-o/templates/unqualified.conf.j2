{%- set _unqualified_registries = [] -%}
{% for _registry in crio_registries if _registry.unqualified -%}
{% if _registry.prefix is defined -%}
{%- set _unused = _unqualified_registries.append(_registry.prefix) -%}
{% else %}
{%- set _unused = _unqualified_registries.append(_registry.location) -%}
{%- endif %}
{%- endfor %}
unqualified-search-registries = {{ _unqualified_registries | to_json }}
