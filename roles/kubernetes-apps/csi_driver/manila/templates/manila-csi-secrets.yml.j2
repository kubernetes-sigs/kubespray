---
apiVersion: v1
kind: Secret
metadata:
  name: csi-manila-secrets
  namespace: kube-system
type: Opaque
stringData:
  os-authURL: {{ manila_auth_url | to_json }}
  os-region: {{ manila_region | to_json }}

{% if manila_application_credential_id | length > 0 %}
  os-applicationCredentialID: {{ manila_application_credential_id | to_json }}
  os-applicationCredentialSecret: {{ manila_application_credential_secret | to_json }}

{% elif manila_application_credential_name | length > 0 %}
  os-applicationCredentialName: {{ manila_application_credential_name | to_json }}
  os-applicationCredentialSecret: {{ manila_application_credential_secret | to_json }}
{% if manila_user_id | length > 0 %}
  os-userID: {{ manila_user_id | to_json }}
{% else %}
  os-userName: {{ manila_username | to_json }}
{% endif %}
{% if manila_domain_id | length > 0 %}
  os-userDomainID: {{ manila_domain_id | to_json }}
{% elif manila_domain_name | length > 0 %}
  os-userDomainName: {{ manila_domain_name | to_json }}
{% endif %}

{% else %}
{% if manila_user_id | length > 0 %}
  os-userID: {{ manila_user_id | to_json }}
{% else %}
  os-userName: {{ manila_username | to_json }}
{% endif %}
  os-password: {{ manila_password | to_json }}
{% if manila_tenant_id | length > 0 %}
  os-projectID: {{ manila_tenant_id | to_json }}
{% elif manila_tenant_name | length > 0 %}
  os-projectName: {{ manila_tenant_name | to_json }}
{% endif %}
{% if manila_domain_id | length > 0 %}
  os-userDomainID: {{ manila_domain_id | to_json }}
{% elif manila_domain_name | length > 0 %}
  os-userDomainName: {{ manila_domain_name | to_json }}
{% endif %}
{% endif %}

{% if manila_project_domain_id | length > 0 %}
  os-projectDomainID: {{ manila_project_domain_id | to_json }}
{% elif manila_project_domain_name | length > 0 %}
  os-projectDomainName: {{ manila_project_domain_name | to_json }}
{% endif %}

{% if manila_cacert | length > 0 %}
  os-certAuthority: {{ lookup('file', manila_cacert) | to_json }}
{% endif %}
