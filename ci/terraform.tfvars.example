# Set these to values from the OCI tenancy before creating a Resource Manager stack.
region               = "us-ashburn-1"
compartment_id       = "ocid1.compartment.oc1..example"
availability_domain  = "example:US-ASHBURN-AD-1"
kubernetes_version   = "v1.34.1"
node_image_id        = "ocid1.image.oc1.iad.example"
artifact_bucket_name = "kubespray-ci-artifacts"

# Optional: one bare metal node is always present; the second pool defaults to zero.
on_demand_nodes = 0

# Limit API access to the networks used by CI maintainers and Resource Manager.
api_allowed_ipv4_cidrs = ["192.0.2.0/24"]
api_allowed_ipv6_cidrs = ["2001:db8::/32"]
